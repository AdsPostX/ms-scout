IMPACT_SID=your_impact_sid
IMPACT_TOKEN=your_impact_token

FLEXOFFERS_API_KEY=your_flexoffers_api_key
FLEXOFFERS_DOMAIN_ID=your_domain_id

MAXBOUNTY_EMAIL=your_email
MAXBOUNTY_PASSWORD=your_password

GSHEET_ID=your_google_sheet_id

NOTION_TOKEN=secret_your_notion_token
NOTION_DB_ID=your_notion_database_id

# Latitude telemetry — traces every Claude call to https://latitude.so
# Find these in your Latitude workspace + project settings.
LATITUDE_API_KEY=your_latitude_api_key
LATITUDE_PROJECT_ID=your_latitude_project_id

# Latitude managed prompt (optional — Scout falls back to prompts/scout_system.md if unset)
# LATITUDE_PROMPT_PATH is the prompt path in Latitude, e.g. "scout/system"
# Register prompts/scout_system.md in Latitude and paste the path here.
LATITUDE_PROMPT_PATH=scout/system

# Latitude alert webhook — receives a POST when scout/agent returns an empty response
# Configure in Latitude project settings → Alerts; paste the Slack webhook URL here.
LATITUDE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
